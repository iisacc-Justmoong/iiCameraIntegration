@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(iiFileProviderNative 0.6 CONFIG HINTS "$ENV{IIFILEPROVIDER_PREFIX}" "$ENV{HOME}/.local/SDK/iiFileProvider")






find_dependency(Threads)
if(NOT @BUILD_SHARED_LIBS@ AND @IICAMERA_WITH_FFMPEG@)
    find_dependency(PkgConfig)
    pkg_check_modules(IICameraFFmpeg REQUIRED IMPORTED_TARGET libavformat libavcodec libavdevice libavutil libswscale)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/iiCameraIntergrationTargets.cmake")
set(iiCameraIntergration_Core_FOUND TRUE)
if("ImageProcessing" IN_LIST iiCameraIntergration_FIND_COMPONENTS)
    if(@IICAMERA_WITH_IMAGE_PROCESSING@)
        if(iiCameraIntergration_FIND_REQUIRED_ImageProcessing)
            find_dependency(iiGraphicAdjust 0.5 CONFIG)
        else()
            find_package(iiGraphicAdjust 0.5 CONFIG QUIET)
        endif()
        if(iiGraphicAdjust_FOUND)
            include("${CMAKE_CURRENT_LIST_DIR}/iiCameraImageProcessingTargets.cmake")
            set(iiCameraIntergration_ImageProcessing_FOUND TRUE)
        else()
            set(iiCameraIntergration_ImageProcessing_FOUND FALSE)
        endif()
    else()
        set(iiCameraIntergration_ImageProcessing_FOUND FALSE)
        set(iiCameraIntergration_NOT_FOUND_MESSAGE "ImageProcessing was not enabled when building this package")
    endif()
endif()
check_required_components(iiCameraIntergration)
