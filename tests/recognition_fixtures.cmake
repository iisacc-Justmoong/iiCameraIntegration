if(NOT FFMPEG OR NOT OUTPUT)
    message(FATAL_ERROR "FFMPEG and OUTPUT are required")
endif()
file(MAKE_DIRECTORY "${OUTPUT}")
function(generate)
    execute_process(COMMAND "${FFMPEG}" -nostdin -hide_banner -loglevel error -y ${ARGN}
        RESULT_VARIABLE result ERROR_VARIABLE error TIMEOUT 25)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Media fixture generation failed: ${error}")
    endif()
endfunction()
generate(-f lavfi -i "testsrc=size=64x48:rate=10" -frames:v 1 "${OUTPUT}/still.png")
generate(-f lavfi -i "testsrc=size=64x48:rate=10" -frames:v 1 "${OUTPUT}/still.jpg")
generate(-f lavfi -i "sine=frequency=440:sample_rate=8000" -t 0.6 -c:a pcm_s16le -metadata "title=iiCamera recognition fixture" "${OUTPUT}/audio.wav")
generate(-f lavfi -i "sine=frequency=440:sample_rate=8000" -t 0.6 -c:a flac -metadata "title=iiCamera recognition fixture" "${OUTPUT}/audio.flac")
generate(-f lavfi -i "testsrc=size=64x48:rate=10" -f lavfi -i "sine=frequency=440:sample_rate=48000" -t 0.6 -c:v libx264 -pix_fmt yuv420p -c:a aac -metadata "title=iiCamera recognition fixture" "${OUTPUT}/clip.mp4")
generate(-f lavfi -i "testsrc=size=64x48:rate=10" -f lavfi -i "sine=frequency=440:sample_rate=48000" -t 0.6 -c:v libvpx-vp9 -pix_fmt yuv420p -c:a libopus -metadata "title=iiCamera recognition fixture" "${OUTPUT}/clip.webm")
generate(-f lavfi -i "testsrc=size=64x48:rate=10" -f lavfi -i "sine=frequency=440:sample_rate=8000" -t 0.6 -c:v ffv1 -c:a pcm_s16le -metadata "title=iiCamera recognition fixture" "${OUTPUT}/original.mkv")
