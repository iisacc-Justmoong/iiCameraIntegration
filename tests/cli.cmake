# Historical test retained for reference. The separate Media consumer maintains
# the equivalent CLI checks in example/Media/tests/cli.py.
file(MAKE_DIRECTORY "${OUTPUT}")
set(image "${OUTPUT}/cli-red.ppm")
file(REMOVE "${image}")
execute_process(COMMAND "${TOOL}" --frame lavfi "color=c=red:size=16x16:rate=10:duration=0.2" "${image}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Frame CLI failed: ${error}")
endif()
file(SIZE "${image}" size)
file(READ "${image}" header HEX LIMIT 16)
string(SUBSTRING "${header}" 0 26 prefix)
if(NOT size EQUAL 781 OR NOT prefix STREQUAL "50360a31362031360a3235350a")
    message(FATAL_ERROR "Invalid PPM frame dimensions/storage")
endif()
string(SUBSTRING "${header}" 26 2 r)
string(SUBSTRING "${header}" 28 2 g)
string(SUBSTRING "${header}" 30 2 b)
math(EXPR red "0x${r}")
math(EXPR green "0x${g}")
math(EXPR blue "0x${b}")
if(red LESS 200 OR green GREATER 40 OR blue GREATER 40)
    message(FATAL_ERROR "Generated PPM does not contain red frame pixels")
endif()
file(SHA256 "${image}" before)
execute_process(COMMAND "${TOOL}" --frame lavfi "color=c=blue:size=16x16:rate=10:duration=0.2" "${image}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
file(SHA256 "${image}" after)
if(status EQUAL 0 OR NOT before STREQUAL after)
    message(FATAL_ERROR "Frame CLI did not preserve existing output")
endif()
execute_process(COMMAND "${TOOL}" --probe "${image}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
if(NOT status EQUAL 0 OR NOT output MATCHES "codec=ppm.*dimensions=16x16")
    message(FATAL_ERROR "PPM artifact not recognized by media probe: ${output} ${error}")
endif()
