execute_process(COMMAND "${TOOL}" RESULT_VARIABLE status OUTPUT_VARIABLE json)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Feature JSON fixture failed: ${status}")
endif()
string(JSON schema GET "${json}" schemaVersion)
string(JSON count LENGTH "${json}" devices)
string(JSON name GET "${json}" devices 0 features camera name)
string(JSON bytes GET "${json}" devices 0 features nativeFeatures 0 value 1)
string(JSON nativeError GET "${json}" devices 0 features controls 0 error code)
string(JSON missing GET "${json}" devices 1 error code)
if(NOT schema EQUAL 1 OR NOT count EQUAL 2 OR NOT bytes EQUAL 255 OR NOT nativeError EQUAL 5 OR NOT missing EQUAL 4)
    message(FATAL_ERROR "Feature JSON structure or partial errors did not survive serialization")
endif()
if(NOT name STREQUAL "Camera \"A\"\n한국어")
    message(FATAL_ERROR "Quoted/UTF-8 camera name did not survive JSON serialization")
endif()
