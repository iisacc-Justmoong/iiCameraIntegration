# Historical pre-migration check. The active CLI contract is in
# example/ImageProcessing/tests/cli.py and uses provider-owned temporary resources.
file(MAKE_DIRECTORY "${OUTPUT}")
set(image "${OUTPUT}/developed-gray.ppm")
file(REMOVE "${image}")
execute_process(COMMAND "${TOOL}" lavfi "color=c=0x404040:size=16x16:rate=10:duration=0.2" "${image}" srgb 1
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Photo processing CLI failed: ${error}")
endif()
file(SIZE "${image}" size)
file(READ "${image}" header HEX LIMIT 16)
string(SUBSTRING "${header}" 0 26 prefix)
if(NOT size EQUAL 781 OR NOT prefix STREQUAL "50360a31362031360a3235350a")
    message(FATAL_ERROR "Invalid processed PPM dimensions/storage")
endif()
string(SUBSTRING "${header}" 26 2 first)
math(EXPR pixel "0x${first}")
if(pixel LESS 80 OR pixel GREATER 95)
    message(FATAL_ERROR "Exposure was not applied to gray source: ${pixel}")
endif()
file(SHA256 "${image}" before)
execute_process(COMMAND "${TOOL}" lavfi "color=c=blue:size=16x16:rate=10:duration=0.2" "${image}" srgb
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
file(SHA256 "${image}" after)
if(status EQUAL 0 OR NOT before STREQUAL after)
    message(FATAL_ERROR "Photo CLI overwrote its existing output")
endif()
