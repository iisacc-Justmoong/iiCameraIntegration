if(NOT PREFIX OR NOT IS_DIRECTORY "${PREFIX}")
    message(FATAL_ERROR "A populated PREFIX is required")
endif()
file(GLOB_RECURSE workspace_metadata LIST_DIRECTORIES FALSE
    "${PREFIX}/.*.iisacc-preview" "${PREFIX}/.iisacc-temporary.lock" "${PREFIX}/.DS_Store")
if(workspace_metadata)
    message(FATAL_ERROR "Workspace metadata must not be installed: ${workspace_metadata}")
endif()
set(_license "${PREFIX}/share/iiCameraIntegration/LICENSE")
set(_notice "${PREFIX}/share/iiCameraIntegration/NOTICE")
if(NOT EXISTS "${_license}" OR NOT EXISTS "${_notice}")
    message(FATAL_ERROR "Installed package must include LICENSE and NOTICE")
endif()
file(READ "${_license}" _license_text)
file(READ "${_notice}" _notice_text)
string(FIND "${_license_text}" "Apache License" _apache_at)
string(FIND "${_license_text}" "Version 2.0, January 2004" _version_at)
string(FIND "${_notice_text}" "Copyright (c) 2026 iisacc" _copyright_at)
if(_apache_at LESS 0 OR _version_at LESS 0)
    message(FATAL_ERROR "Installed LICENSE must be Apache-2.0")
endif()
if(_copyright_at LESS 0)
    message(FATAL_ERROR "Installed NOTICE must contain Copyright (c) 2026 iisacc")
endif()
