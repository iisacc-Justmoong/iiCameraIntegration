if(NOT IICAMERA_SOURCE)
    message(FATAL_ERROR "IICAMERA_SOURCE is required")
endif()
function(require_text path needle message)
    file(READ "${path}" contents)
    string(FIND "${contents}" "${needle}" found)
    if(found LESS 0)
        message(FATAL_ERROR "${message}: ${path}")
    endif()
endfunction()
function(reject_text path needle message)
    file(READ "${path}" contents)
    string(FIND "${contents}" "${needle}" found)
    if(NOT found LESS 0)
        message(FATAL_ERROR "${message}: ${path}")
    endif()
endfunction()
require_text("${IICAMERA_SOURCE}/LICENSE" "Apache License" "LICENSE must be the Apache License")
require_text("${IICAMERA_SOURCE}/LICENSE" "Version 2.0, January 2004" "LICENSE must be Apache-2.0")
require_text("${IICAMERA_SOURCE}/LICENSE" "http://www.apache.org/licenses/" "LICENSE must cite the Apache license URL")
require_text("${IICAMERA_SOURCE}/LICENSE" "END OF TERMS AND CONDITIONS" "LICENSE must include the full Apache-2.0 terms")
string(CONCAT mit_grant "Permission is hereby granted, " "free of charge")
reject_text("${IICAMERA_SOURCE}/LICENSE" "${mit_grant}" "LICENSE must not retain the MIT license text")
require_text("${IICAMERA_SOURCE}/NOTICE" "Copyright (c) 2026 iisacc" "NOTICE must contain the copyright notice")
require_text("${IICAMERA_SOURCE}/README.md" "SPDX-License-Identifier: Apache-2.0" "README SPDX identifier must be Apache-2.0")
require_text("${IICAMERA_SOURCE}/docs/License.md" "SPDX-License-Identifier: Apache-2.0" "Korean license document must state Apache-2.0")
require_text("${IICAMERA_SOURCE}/AGENT.md" "Apache License 2.0" "AGENT.md must state Apache License 2.0")
require_text("${IICAMERA_SOURCE}/cmake/iiCameraIntegrationConfig.cmake.in" "set(iiCameraIntegration_SPDX_LICENSE \"Apache-2.0\")" "Package config must export the SPDX license")
require_text("${IICAMERA_SOURCE}/example/ImageProcessing/cmake/iiCameraImageProcessingConfig.cmake.in" "set(iiCameraImageProcessing_SPDX_LICENSE \"Apache-2.0\")" "Image-processing package config must export the SPDX license")
require_text("${IICAMERA_SOURCE}/CMakeLists.txt" "set(iiCameraIntegration_SPDX_LICENSE \"Apache-2.0\")" "The package build must set the SPDX license")
require_text("${IICAMERA_SOURCE}/CMakeLists.txt" "install(FILES LICENSE NOTICE" "Install rules must copy LICENSE and NOTICE")
file(GLOB_RECURSE claims LIST_DIRECTORIES FALSE
    "${IICAMERA_SOURCE}/*.md" "${IICAMERA_SOURCE}/*.h" "${IICAMERA_SOURCE}/*.hpp"
    "${IICAMERA_SOURCE}/*.cpp" "${IICAMERA_SOURCE}/*.c" "${IICAMERA_SOURCE}/*.mm"
    "${IICAMERA_SOURCE}/*.cmake" "${IICAMERA_SOURCE}/*.in" "${IICAMERA_SOURCE}/*.txt"
    "${IICAMERA_SOURCE}/*.json" "${IICAMERA_SOURCE}/*.py" "${IICAMERA_SOURCE}/*.sh")
string(CONCAT mit_spdx "SPDX-License-Identifier: " "MIT")
foreach(path IN LISTS claims)
    if(path MATCHES "/build/" OR path MATCHES "/\\.git/")
        continue()
    endif()
    reject_text("${path}" "${mit_spdx}" "First-party SPDX identifier is still MIT")
    reject_text("${path}" "${mit_grant}" "MIT license text remains")
endforeach()
