if(NOT RESOURCE_ROOT OR NOT OUTPUT_DIR)
    message(FATAL_ERROR "RESOURCE_ROOT and OUTPUT_DIR are required")
endif()
if(IS_SYMLINK "${RESOURCE_ROOT}" OR IS_SYMLINK "${OUTPUT_DIR}")
    message(FATAL_ERROR "Test output roots must not be symlinks")
endif()
cmake_path(ABSOLUTE_PATH RESOURCE_ROOT NORMALIZE OUTPUT_VARIABLE _root)
cmake_path(ABSOLUTE_PATH OUTPUT_DIR NORMALIZE OUTPUT_VARIABLE _output)
cmake_path(IS_PREFIX _root "${_output}" NORMALIZE _inside)
if(NOT _inside OR _root STREQUAL _output)
    message(FATAL_ERROR "Camera test output must be under the resource state directory")
endif()
